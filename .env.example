# انسخ هذا الملف إلى .env وضع المفاتيح. لا تُرفع .env أبدًا.
# المزود: groq (افتراضي) أو gemini أو fake (بلا شبكة، للاختبار)
SAADEED_LLM_PROVIDER=groq
SAADEED_LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=
# مجلد ذاكرة النداءات (تسجيل وإعادة). احذفه لإعادة النداءات من جديد.
SAADEED_CACHE_DIR=.cache/llm
